<settings xmlns="http://maven.apache.org/SETTINGS/1.0.0"
          xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
          xsi:schemaLocation="http://maven.apache.org/SETTINGS/1.0.0 https://maven.apache.org/xsd/settings-1.0.0.xsd">
    <mirrors>
        <mirror>
            <id>central-proxy</id>
            <mirrorOf>central</mirrorOf>
            <name>HTTPS central mirror</name>
            <url>https://repo1.maven.org/maven2/</url>
        </mirror>
    </mirrors>
    <profiles>
        <profile>
            <id>stabilize-http-client</id>
            <properties>
                <maven.wagon.http.retryHandler.count>5</maven.wagon.http.retryHandler.count>
                <maven.wagon.httpconnectionManager.ttlSeconds>120</maven.wagon.httpconnectionManager.ttlSeconds>
                <maven.wagon.http.pool>false</maven.wagon.http.pool>
                <maven.wagon.http.userAgent>Mozilla/5.0 (AI-Trading-Bot Build Agent)</maven.wagon.http.userAgent>
            </properties>
        </profile>
    </profiles>
    <activeProfiles>
        <activeProfile>stabilize-http-client</activeProfile>
    </activeProfiles>
</settings>
